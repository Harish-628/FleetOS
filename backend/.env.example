# ==========================================
# FleetOS Backend Production Environment Config
# ==========================================

# 1. Database (Neon PostgreSQL connection string)
# Example: postgresql://username:password@ep-cool-cloud-12345.us-east-2.aws.neon.tech/fleetos?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./fleetos.db

# 2. Authentication & JWT Hardening
JWT_SECRET_KEY=replace-with-a-64-character-random-hex-string-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_PASSWORD_HASH=

# 3. Driver Mobile QR Authentication
DRIVER_QR_SECRET=driver-cockpit-secret-key-2026

# 4. Storage Engine ("local" for dev, "s3" or "r2" for production)
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_BYTES=1048576

# S3-Compatible Storage Credentials (Supabase Storage, Cloudflare R2, AWS S3)
# For Supabase Storage:
# S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-southeast-1
# S3_ACCESS_KEY_ID=your_supabase_s3_access_key
# S3_SECRET_ACCESS_KEY=your_supabase_s3_secret_key
# S3_BUCKET_NAME=fleetos-receipts
# S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/fleetos-receipts
#
# For Cloudflare R2:
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=your_r2_access_key_id
# S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
# S3_BUCKET_NAME=fleetos-receipts
# S3_PUBLIC_URL=https://receipts.yourdomain.com
S3_ENDPOINT_URL=
S3_REGION=ap-southeast-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=fleetos-receipts
S3_PUBLIC_URL=

# 5. Live Google Calendar API Integration
# Paste the base64-encoded string of service_account.json: `base64 -w 0 service_account.json`
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=primary

# 6. CORS Whitelist (Comma-separated origins for production)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://fleetos.vercel.app,https://fleetos.pages.dev
